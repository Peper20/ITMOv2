{
  "$schema": "https://opencode.ai/config.json",
  "model": "llamacpp/qwen3.6-35b",
  "small_model": "llamacpp/qwen3.6-35b",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp local",
      "options": {
        "baseURL": "http://127.0.0.1:9931/v1",
        "apiKey": "{file:~/.config/llama/api-key}"
      },
      "models": {
        "qwen3.6-35b": {
          "name": "Qwen3.6 35B-A3B IQ4_XS local",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    }
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "title": {
      "disable": true
    }
  },
  "enabled_providers": [
    "llamacpp"
  ]
}
